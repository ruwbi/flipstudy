# Copy to .env for local development. On Render, set these in the dashboard.

# Long random string used to sign login tokens.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# The origin your frontend is served from (scheme + host, no path, no trailing slash).
#   GitHub Pages: https://YOUR-USERNAME.github.io
#   Local:        http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
